<?xml version='1.0' encoding='utf-8'?>
<modDesc descVersion="115">
    <author>PropaineX</author>
    <version>2.0.0.0</version>
    <title>
        <en>PX150XL Windrower</en>
    </title>
    <description>
        <en>15.2 m grain windrower header for the MacDon M1240. Cuts supported grain crops into swaths for pickup with the MacDon PW8. Requires MacDon Pack.</en>
    </description>
    <iconFilename>store_headerHD50F.dds</iconFilename>
    <multiplayer supported="true" />
    <dependencies>
        <dependency>pdlc_macDonPack</dependency>
    </dependencies>
    <l10n>
        <text name="px150_functionWindrower">
            <en>Cuts grain and lays a swath (MacDon M1240)</en>
        </text>
        <text name="px150_turnOn">
            <en>Turn on header</en>
        </text>
        <text name="px150_turnOff">
            <en>Turn off header</en>
        </text>
    </l10n>
    <brands>
        <brand name="PROPAINEX" title="PropaineX" image="brand_propainex.dds" />
    </brands>
    <storeItems>
        <storeItem xmlFilename="px150xlWindrower.xml" />
    </storeItems>
</modDesc>