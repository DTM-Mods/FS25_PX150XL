<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Pickup straw effect for the rye and triticale swaths (fillTypes/px150Swaths.xml).
     Copied from the base game's $data/effects/pickup/pickupEffects.xml, which lists only the
     base swaths; uses the same meshes and the same straw material as WHEAT_CUT.
     Loaded by scripts/PX150GrainHeaderCrops.lua after the map's own motion path effects. -->
<motionPathEffects>
    <motionPathEffect effectClass="TypedMotionPathEffect" effectType="PICKUPIN" filename="$data/effects/pickup/pickupIN.i3d">
        <effectGeneration rootNode="0|0"/>
        <typeDefinition fillTypes="PX150_RYE_SWATH PX150_TRITICALE_SWATH" speedScale="1.4"/>

        <effectMeshes>
            <effectMesh node="0|0|0"  numRows="6"  rowLength="18" skipPositions="0" boundingBox="4 4 4"/>
            <effectMesh node="0|0|1"  numRows="9"  rowLength="11" skipPositions="0" boundingBox="3 4 4"/>
            <effectMesh node="0|0|2"  numRows="10" rowLength="5"  skipPositions="0" boundingBox="3 4 4"/>
            <effectMesh node="0|0|3"  numRows="10" rowLength="15" skipPositions="0" boundingBox="3 4 4"/>
            <effectMesh node="0|0|4"  numRows="10" rowLength="10" skipPositions="0" boundingBox="3 4 4"/>
            <effectMesh node="0|0|5"  numRows="12" rowLength="10" skipPositions="0" boundingBox="3 4 4"/>
            <effectMesh node="0|0|6"  numRows="14" rowLength="10" skipPositions="0" boundingBox="3 4 4"/>
            <effectMesh node="0|0|7"  numRows="14" rowLength="25" skipPositions="0" boundingBox="5 5 5"/>
            <effectMesh node="0|0|8"  numRows="16" rowLength="15" skipPositions="0" boundingBox="4 4 4"/>
            <effectMesh node="0|0|9"  numRows="18" rowLength="20" skipPositions="0" boundingBox="4 4 4"/>
            <effectMesh node="0|0|10" numRows="24" rowLength="10" skipPositions="0" boundingBox="5 5 5"/>
            <effectMesh node="0|0|11" numRows="24" rowLength="25" skipPositions="0" boundingBox="5 5 5"/>
        </effectMeshes>

        <effectMaterials rootNode="0|1">
            <effectMaterial node="0|1|0" fillTypes="PX150_RYE_SWATH PX150_TRITICALE_SWATH" />
        </effectMaterials>

        <customShaderDefaults>
            <customShaderVariation name="alphaMapGradient"/>
            <customShaderParameter name="visibilityX"   value="1.5 -1.5 0.0 0.0"/>
            <customShaderParameter name="sizeScale"     value="1.0 1.0 0.0 0.0"/>
            <customShaderMap name="shapeArray" filename="$data/effects/pickup/sharedPickupArrayIN.dds"/>
            <customShaderMap name="alphaMap"   filename="$data/effects/pickup/shared/gradient_diffuse.png"/>
        </customShaderDefaults>
    </motionPathEffect>

    <motionPathEffect effectClass="TypedMotionPathEffect" effectType="PICKUPOUT" filename="$data/effects/pickup/pickupOUT.i3d">
        <effectGeneration rootNode="0|2"/>
        <typeDefinition fillTypes="PX150_RYE_SWATH PX150_TRITICALE_SWATH" speedScale="0.65"/>

        <effectMeshes>
            <effectMesh node="0|0|0" numRows="4" rowLength="22" skipPositions="1" boundingBox="3 6 6"/>
        </effectMeshes>

        <effectMaterials rootNode="0|3">
            <effectMaterial node="0|1|0" fillTypes="PX150_RYE_SWATH PX150_TRITICALE_SWATH" />
        </effectMaterials>

        <customShaderDefaults>
            <customShaderVariation name="rotateByLife_cosOffsetY_alphaMapGradient"/>
            <customShaderParameter name="rotateSpeed"   value="5.0 0 0 0"/>
            <customShaderMap name="shapeArray" filename="$data/effects/pickup/sharedPickupArrayOUT.dds"/>
            <customShaderMap name="alphaMap"   filename="$data/effects/pickup/shared/gradient_diffuse.png"/>
        </customShaderDefaults>
    </motionPathEffect>
</motionPathEffects>
